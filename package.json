{
  "name": "mycoder",
  "version": "0.1.0",
  "private": true,
  "description": "MyCoder — a coding agent kernel: small, verifiable, with explicit security boundaries.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "mycoder": "./bin/mycoder.mjs"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "agent": "node src/cli/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:sandbox": "node scripts/build-sandbox.ts",
    "eval": "node evals/runners/run.ts",
    "eval:delegation-utility": "node evals/experiments/delegation-utility.ts",
    "eval:tool-utility": "node evals/experiments/tool-utility.ts",
    "eval:undo-utility": "node evals/experiments/undo-utility.ts",
    "evidence": "node scripts/evidence.ts",
    "format": "prettier --write \"**/*.{ts,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml}\"",
    "lint": "node scripts/lint.ts",
    "lint:selftest": "node --test --experimental-strip-types \"tests/lint/**/*.test.ts\"",
    "mycoder": "node src/cli/main.ts",
    "package:check": "node scripts/package-check.ts",
    "release:pack": "node scripts/pack.ts",
    "test": "node --test --experimental-strip-types \"tests/**/*.test.ts\"",
    "test:conformance": "node --test --experimental-strip-types tests/integration/backend-conformance.test.ts",
    "test:container": "KERNEL_CONTAINER=1 node --test --experimental-strip-types \"tests/live/container-*.test.ts\" \"tests/unit/container-plan.test.ts\" \"tests/integration/backend-conformance.test.ts\"",
    "test:credentials": "node --test --experimental-strip-types \"tests/security/credential-file.test.ts\" \"tests/security/credential-isolation.test.ts\"",
    "test:delegation": "node --test --experimental-strip-types \"tests/integration/delegation*.test.ts\" \"tests/security/delegation-attacks.test.ts\" \"tests/integration/skill-runtime.test.ts\"",
    "test:egress": "node --test --experimental-strip-types \"tests/unit/egress-*.test.ts\" \"tests/security/egress-composition.test.ts\"",
    "test:egress:live": "KERNEL_CONTAINER=1 node --test --experimental-strip-types \"tests/live/container-egress.test.ts\" \"tests/live/container-resources.test.ts\"",
    "test:evals": "node --test --experimental-strip-types \"tests/evals/**/*.test.ts\"",
    "test:integration": "node --test --experimental-strip-types \"tests/integration/**/*.test.ts\"",
    "test:live:model": "KERNEL_LIVE=1 node --test --experimental-strip-types \"tests/live/model-live.test.ts\"",
    "test:model": "node --test --experimental-strip-types \"tests/model/**/*.test.ts\"",
    "test:packaging": "node --test --experimental-strip-types \"tests/integration/packaging.test.ts\" \"tests/integration/runtime-version.test.ts\" \"tests/integration/cli-contract.test.ts\"",
    "test:platform": "node --test --experimental-strip-types \"tests/unit/**/*.test.ts\" \"tests/integration/**/*.test.ts\"",
    "test:replay": "node --test --experimental-strip-types tests/integration/replay-gate.test.ts",
    "test:security": "node --test --experimental-strip-types \"tests/security/**/*.test.ts\"",
    "test:smoke": "node --test --experimental-strip-types \"tests/smoke/**/*.test.ts\"",
    "test:soak": "node --test --experimental-strip-types tests/integration/delegation-soak.test.ts",
    "test:ssh": "KERNEL_SSH=1 node --test --experimental-strip-types \"tests/live/ssh-live.test.ts\" \"tests/live/ssh-session.test.ts\" \"tests/live/ssh-delegation.test.ts\"",
    "test:trajectory": "node --test --experimental-strip-types tests/integration/agent-loop.test.ts",
    "test:unit": "node --test --experimental-strip-types \"tests/unit/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "comment:dependencies": "v0.1 intentionally ships with zero RUNTIME dependencies; typescript, @types/node and prettier are devDependencies used only by `pnpm typecheck` and `pnpm format:check`. `pnpm lint` is scripts/lint.ts, a zero-dependency architecture linter — see its header for why it is not ESLint. Node >=22.6 strips TypeScript types natively and provides node:test, fetch, crypto and fs/promises. Glob matching, unified diff, TOML parsing and JSON Schema validation are implemented in src/util/ so that the kernel — and in particular its security tests — can run fully offline with no supply chain surface. See docs/adr/ADR-0009-zero-runtime-dependencies.md.",
  "files": [
    "bin/",
    "dist/",
    "src/",
    "native/",
    "scripts/build-sandbox.ts",
    "docs/adr/",
    "docs/threat-model.md",
    "docs/cli-contract.md",
    "docs/configuration-audit.md",
    "docs/installing.md",
    "docs/configuring-a-provider.md",
    "docs/web-access.md",
    "README.md",
    "build-info.json"
  ]
}
